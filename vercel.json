{
  "version": 2,
  "rewrites": [
    {
      "source": "/api/(.*)",
      "destination": "/api/index.js"
    },
    {
      "version": 2,
      "rewrites": [
        {
          "source": "/api/(.*)",
          "destination": "/api/index.ts"
        },
        {
          "source": "/(.*)",
          "destination": "/index.html"
        }
      ],
      "functions": {
        "api/index.js": {
          "includeFiles": "dist/**, server/**, shared/**"
        }
      }
    }