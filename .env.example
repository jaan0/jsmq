# ==================================
# JSMQ Environment Configuration
# ==================================
# Copy this file to .env and fill in your values
# DO NOT commit .env file to version control

# ==================================
# Application Settings (Required)
# ==================================

# Node environment: development | production | test
NODE_ENV=development

# Server port (default: 5000)
PORT=5000

# Session secret for cookie encryption
# Generate a secure random string (minimum 32 characters)
# Example: openssl rand -base64 32
SESSION_SECRET=change-this-to-a-secure-random-string-minimum-32-characters

# ==================================
# Database (Optional)
# ==================================

# MongoDB connection string
# If not provided, application will use in-memory storage
# Note: In-memory storage will lose all data on restart

# Local MongoDB:
# DATABASE_URL=mongodb://localhost:27017/jsmq_webflow

# MongoDB Atlas (recommended for production):
# DATABASE_URL=mongodb+srv://username:password@cluster.mongodb.net/jsmq_webflow?retryWrites=true&w=majority

# ==================================
# Email Configuration (Optional)
# ==================================

# Email service for order confirmations and notifications
# If not configured, emails will be logged to console only

# For Gmail, use an App Password (not your regular password)
# Generate at: https://myaccount.google.com/apppasswords
EMAIL_USER=your-email@gmail.com
EMAIL_PASS=your-app-specific-password

# For other email providers, you may need to modify server/email.ts
# Supported services: gmail, outlook, yahoo, etc.

# ==================================
# Cloudinary (Optional)
# ==================================

# Image upload and hosting service
# Sign up at: https://cloudinary.com
# If not configured, image uploads will fail

CLOUDINARY_CLOUD_NAME=your-cloud-name
CLOUDINARY_API_KEY=your-api-key
CLOUDINARY_API_SECRET=your-api-secret

# Default folder for uploads (optional)
CLOUDINARY_UPLOAD_FOLDER=jsmq

# ==================================
# File Upload Settings (Optional)
# ==================================

# Maximum file upload size in bytes
# Default: 10485760 (10 MB)
UPLOAD_MAX_BYTES=10485760

# ==================================
# Vercel Deployment (Optional)
# ==================================

# Set automatically by Vercel
# VERCEL=1

# ==================================
# Security Notes
# ==================================
# 
# 1. Never commit your .env file to version control
# 2. Use strong, unique values for SESSION_SECRET
# 3. In production, always use HTTPS
# 4. Rotate credentials regularly
# 5. Use environment-specific .env files:
#    - .env.development
#    - .env.production
#    - .env.test
#
# ==================================
# Production Checklist
# ==================================
#
# Before deploying to production, ensure:
# ☐ SESSION_SECRET is set to a strong random value
# ☐ DATABASE_URL points to a production database
# ☐ Email credentials are configured (recommended)
# ☐ Cloudinary is configured (recommended)
# ☐ NODE_ENV is set to 'production'
# ☐ All sensitive values are stored securely
# ☐ Authentication middleware is implemented (see CODE_REVIEW.md)
#
